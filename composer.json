{
    "name": "schachbulle/contao-einstellungen-bundle",
    "type": "contao-bundle",
    "description": "Stellt Einstellungen im Backend wieder her, die Contao ab Version 4.7 nicht mehr anbietet.",
    "keywords": [
        "contao",
        "einstellungen",
        "backend",
        "tl_settings"
    ],
    "homepage": "https://github.com/Samson1964/contao-einstellungen-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^5.6 || ^7.0 || ^8.0",
        "contao/core-bundle": "^4"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "doctrine/doctrine-cache-bundle": "^1.3"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoEinstellungenBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoEinstellungenBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-einstellungen-bundle/issues",
        "source": "https://github.com/Samson1964/contao-einstellungen-bundle"
    }
}
